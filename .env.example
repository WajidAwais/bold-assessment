# Dev defaults. Copy to .env to override; docker compose and the backend both read these.

# Compose Postgres (published on host port 5433 so it doesn't clash with a local 5432)
POSTGRES_USER=techforce
POSTGRES_PASSWORD=techforce
POSTGRES_DB=techforce
POSTGRES_HOST_PORT=5433

# Backend, when run on the host (owner role: runs migrations and the import)
DATABASE_URL=postgresql+asyncpg://techforce:techforce@localhost:5433/techforce

# Tests: a separate database on the same cluster, created automatically if missing
TEST_DATABASE_NAME=techforce_test

# Backend reads (non-owner techforce_app role, no BYPASSRLS; the migration creates it with this password)
APP_DATABASE_URL=postgresql+asyncpg://techforce_app:techforce_app@localhost:5433/techforce
